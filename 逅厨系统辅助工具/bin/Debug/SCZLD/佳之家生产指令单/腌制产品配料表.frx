    private string lasttext1=&quot;&quot;;
    private string lastadd=&quot;&quot;;
    
    

    private void Text5_BeforePrint(object sender, EventArgs e)
    {
      DataSourceBase dsb= Report.GetDataSource(&quot;腌制产品配料表&quot;);
      if(lasttext1==&quot;&quot;||dsb[&quot;产品名称&quot;].ToString()!=lasttext1)
      {
        lasttext1= dsb[&quot;产品名称&quot;].ToString();
        lastadd=lastadd==&quot;&quot;?((char)0).ToString():&quot;&quot;;
      }
      Text5.Text=Text5.Text+lastadd;
    }
    
    
    

    private void Text22_BeforePrint(object sender, EventArgs e)
    {
      Text22.Text=Text22.Text+lastadd;
    }

    private void Text17_BeforePrint(object sender, EventArgs e)
    {
      Text17.Text=Text17.Text+lastadd;
    }
    
    

    private void Text19_BeforePrint(object sender, EventArgs e)
    {
      Text19.Text=Text19.Text+lastadd;
    }
  }
}
