<Report ScriptLanguage="CSharp" ReportInfo.Created="05/19/2026 16:32:06" ReportInfo.Modified="06/23/2026 09:09:03" ReportInfo.CreatorVersion="2021.2.8.0">
  <ScriptText>using System;
using System.Collections;
using System.Collections.Generic;
using System.ComponentModel;
using System.Windows.Forms;
using System.Drawing;
using System.Data;
using FastReport;
using FastReport.Data;
using FastReport.Dialog;
using FastReport.Barcode;
using FastReport.Table;
using FastReport.Utils;

namespace FastReport
{
  public class ReportScript
  {

    private void Table1_AfterData(object sender, EventArgs e)
    {  
      //直接材料占比
       Cell78.Text=Convert.ToDecimal(Cell13.Value)&gt;0?FormatNumber((Convert.ToDecimal(Cell23.Value)/Convert.ToDecimal(Cell13.Value))*100,2).ToString()+&quot;%&quot;:&quot; &quot;;  
       Cell79.Text=Convert.ToDecimal(Cell14.Value)&gt;0?FormatNumber((Convert.ToDecimal(Cell24.Value)/Convert.ToDecimal(Cell14.Value))*100,2).ToString()+&quot;%&quot;:&quot; &quot;;
       Cell80.Text=Convert.ToDecimal(Cell15.Value)&gt;0?FormatNumber((Convert.ToDecimal(Cell25.Value)/Convert.ToDecimal(Cell15.Value))*100,2).ToString()+&quot;%&quot;:&quot; &quot;;
       Cell81.Text=Convert.ToDecimal(Cell46.Value)&gt;0?FormatNumber((Convert.ToDecimal(Cell66.Value)/Convert.ToDecimal(Cell46.Value))*100,2).ToString()+&quot;%&quot;:&quot; &quot;;
       Cell82.Text=Convert.ToDecimal(Cell47.Value)&gt;0?FormatNumber((Convert.ToDecimal(Cell67.Value)/Convert.ToDecimal(Cell47.Value))*100,2).ToString()+&quot;%&quot;:&quot; &quot;;
       Cell83.Text=Convert.ToDecimal(Cell48.Value)&gt;0?FormatNumber((Convert.ToDecimal(Cell68.Value)/Convert.ToDecimal(Cell48.Value))*100,2).ToString()+&quot;%&quot;:&quot; &quot;;
      //人工占比
      Cell108.Text=Convert.ToDecimal(Cell13.Value)&gt;0?FormatNumber((Convert.ToDecimal(Cell93.Value)/Convert.ToDecimal(Cell13.Value))*100,2).ToString()+&quot;%&quot;:&quot; &quot;;  
      Cell109.Text=Convert.ToDecimal(Cell14.Value)&gt;0?FormatNumber((Convert.ToDecimal(Cell94.Value)/Convert.ToDecimal(Cell14.Value))*100,2).ToString()+&quot;%&quot;:&quot; &quot;;
      Cell110.Text=Convert.ToDecimal(Cell15.Value)&gt;0?FormatNumber((Convert.ToDecimal(Cell95.Value)/Convert.ToDecimal(Cell15.Value))*100,2).ToString()+&quot;%&quot;:&quot; &quot;;
      Cell111.Text=Convert.ToDecimal(Cell46.Value)&gt;0?FormatNumber((Convert.ToDecimal(Cell96.Value)/Convert.ToDecimal(Cell46.Value))*100,2).ToString()+&quot;%&quot;:&quot; &quot;;
      Cell112.Text=Convert.ToDecimal(Cell47.Value)&gt;0?FormatNumber((Convert.ToDecimal(Cell97.Value)/Convert.ToDecimal(Cell47.Value))*100,2).ToString()+&quot;%&quot;:&quot; &quot;;
      Cell113.Text=Convert.ToDecimal(Cell48.Value)&gt;0?FormatNumber((Convert.ToDecimal(Cell98.Value)/Convert.ToDecimal(Cell48.Value))*100,2).ToString()+&quot;%&quot;:&quot; &quot;;
    
      //能耗占比
      Cell138.Text=Convert.ToDecimal(Cell13.Value)&gt;0?FormatNumber((Convert.ToDecimal(Cell123.Value)/Convert.ToDecimal(Cell13.Value))*100,2).ToString()+&quot;%&quot;:&quot; &quot;;  
      Cell139.Text=Convert.ToDecimal(Cell14.Value)&gt;0?FormatNumber((Convert.ToDecimal(Cell124.Value)/Convert.ToDecimal(Cell14.Value))*100,2).ToString()+&quot;%&quot;:&quot; &quot;;
      Cell140.Text=Convert.ToDecimal(Cell15.Value)&gt;0?FormatNumber((Convert.ToDecimal(Cell125.Value)/Convert.ToDecimal(Cell15.Value))*100,2).ToString()+&quot;%&quot;:&quot; &quot;;
      Cell141.Text=Convert.ToDecimal(Cell46.Value)&gt;0?FormatNumber((Convert.ToDecimal(Cell126.Value)/Convert.ToDecimal(Cell46.Value))*100,2).ToString()+&quot;%&quot;:&quot; &quot;;
      Cell142.Text=Convert.ToDecimal(Cell47.Value)&gt;0?FormatNumber((Convert.ToDecimal(Cell127.Value)/Convert.ToDecimal(Cell47.Value))*100,2).ToString()+&quot;%&quot;:&quot; &quot;;
      Cell143.Text=Convert.ToDecimal(Cell48.Value)&gt;0?FormatNumber((Convert.ToDecimal(Cell128.Value)/Convert.ToDecimal(Cell48.Value))*100,2).ToString()+&quot;%&quot;:&quot; &quot;;
      //用量
      Cell228.Text=(Convert.ToDecimal(Cell230.Value) + Convert.ToDecimal(Cell232.Value)).ToString(); //总水
      Cell229.Text=(Convert.ToDecimal(Cell231.Value) + Convert.ToDecimal(Cell233.Value)).ToString(); //总水累计
      Cell243.Text=(Convert.ToDecimal(Cell245.Value) + Convert.ToDecimal(Cell247.Value)).ToString(); //总电
      Cell244.Text=(Convert.ToDecimal(Cell246.Value) + Convert.ToDecimal(Cell248.Value)).ToString(); //总电累计
      Cell273.Text=(Convert.ToDecimal(Cell275.Value) + Convert.ToDecimal(Cell277.Value)).ToString(); //总气
      Cell274.Text=(Convert.ToDecimal(Cell276.Value) + Convert.ToDecimal(Cell278.Value)).ToString(); //总气累计
      Cell288.Text=(Convert.ToDecimal(Cell290.Value) + Convert.ToDecimal(Cell292.Value)).ToString(); //总汽
      Cell289.Text=(Convert.ToDecimal(Cell291.Value) + Convert.ToDecimal(Cell293.Value)).ToString(); //总汽累计
      //气汽用量
      Cell260.Text=(Convert.ToDecimal(Cell275.Value) + Convert.ToDecimal(Cell290.Value)).ToString();//逅厨
      Cell261.Text=(Convert.ToDecimal(Cell276.Value) + Convert.ToDecimal(Cell291.Value)).ToString();//逅厨累计
      Cell262.Text=(Convert.ToDecimal(Cell277.Value) + Convert.ToDecimal(Cell292.Value)).ToString();//一鸣
      Cell263.Text=(Convert.ToDecimal(Cell278.Value) + Convert.ToDecimal(Cell293.Value)).ToString();//一鸣累计
      Cell258.Text=(Convert.ToDecimal(Cell275.Value) + Convert.ToDecimal(Cell277.Value)+Convert.ToDecimal(Cell290.Value) + Convert.ToDecimal(Cell292.Value)).ToString(); //总
      Cell259.Text=(Convert.ToDecimal(Cell276.Value) + Convert.ToDecimal(Cell278.Value)+Convert.ToDecimal(Cell291.Value) + Convert.ToDecimal(Cell293.Value)).ToString();//总累计
      
      //利益项
      Cell336.Text=(Convert.ToInt64(Cell13.Value) - Convert.ToInt64(Cell23.Value)-Convert.ToInt64(Cell93.Value) - Convert.ToInt64(Cell123.Value)).ToString(); //总预估
      Cell345.Text=Convert.ToDecimal(Cell13.Value)&gt;0?FormatNumber((Convert.ToDecimal(Cell13.Value) - Convert.ToDecimal(Cell23.Value)-Convert.ToDecimal(Cell93.Value) - Convert.ToDecimal(Cell123.Value))/Convert.ToDecimal(Cell13.Value)*100,2).ToString()+&quot;%&quot;:&quot; &quot;; //总毛利
      Cell337.Text=(Convert.ToInt64(Cell14.Value) - Convert.ToInt64(Cell24.Value)-Convert.ToInt64(Cell94.Value) - Convert.ToInt64(Cell124.Value)).ToString(); //总预估累计
      Cell346.Text=Convert.ToDecimal(Cell13.Value)&gt;0?FormatNumber((Convert.ToDecimal(Cell14.Value) - Convert.ToDecimal(Cell24.Value)-Convert.ToDecimal(Cell94.Value) - Convert.ToDecimal(Cell124.Value))/Convert.ToDecimal(Cell14.Value)*100,2).ToString()+&quot;%&quot;:&quot; &quot;; //总毛利累计
      Cell338.Text=(Convert.ToInt64(Cell15.Value) - Convert.ToInt64(Cell25.Value)-Convert.ToInt64(Cell95.Value) - Convert.ToInt64(Cell125.Value)).ToString(); //逅厨预估
      Cell347.Text=Convert.ToDecimal(Cell13.Value)&gt;0?FormatNumber((Convert.ToDecimal(Cell15.Value) - Convert.ToDecimal(Cell25.Value)-Convert.ToDecimal(Cell95.Value) - Convert.ToDecimal(Cell125.Value))/Convert.ToDecimal(Cell15.Value)*100,2).ToString()+&quot;%&quot;:&quot; &quot;; //逅厨毛利
      Cell339.Text=(Convert.ToInt64(Cell46.Value) - Convert.ToInt64(Cell66.Value)-Convert.ToInt64(Cell96.Value) - Convert.ToInt64(Cell126.Value)).ToString(); //逅厨预估累计
      Cell348.Text=Convert.ToDecimal(Cell13.Value)&gt;0?FormatNumber((Convert.ToDecimal(Cell46.Value) - Convert.ToDecimal(Cell66.Value)-Convert.ToDecimal(Cell96.Value) - Convert.ToDecimal(Cell126.Value))/Convert.ToDecimal(Cell46.Value)*100,2).ToString()+&quot;%&quot;:&quot; &quot;; //逅厨毛利累计
      Cell340.Text=(Convert.ToInt64(Cell47.Value) - Convert.ToInt64(Cell67.Value)-Convert.ToInt64(Cell97.Value) - Convert.ToInt64(Cell127.Value)).ToString(); //一鸣预估
      Cell349.Text=Convert.ToDecimal(Cell13.Value)&gt;0?FormatNumber((Convert.ToDecimal(Cell47.Value) - Convert.ToDecimal(Cell67.Value)-Convert.ToDecimal(Cell97.Value) - Convert.ToDecimal(Cell127.Value))/Convert.ToDecimal(Cell47.Value)*100,2).ToString()+&quot;%&quot;:&quot; &quot;; //一鸣毛利
      Cell341.Text=(Convert.ToInt64(Cell48.Value) - Convert.ToInt64(Cell68.Value)-Convert.ToInt64(Cell98.Value) - Convert.ToInt64(Cell128.Value)).ToString(); //一鸣预估累计 
      Cell350.Text=Convert.ToDecimal(Cell13.Value)&gt;0?FormatNumber((Convert.ToDecimal(Cell48.Value) - Convert.ToDecimal(Cell68.Value)-Convert.ToDecimal(Cell98.Value) - Convert.ToDecimal(Cell128.Value))/Convert.ToDecimal(Cell48.Value)*100,2).ToString()+&quot;%&quot;:&quot; &quot;; //一鸣毛利累计
    }
  }
}
</ScriptText>
