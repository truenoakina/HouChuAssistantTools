using FastReport.Utils;

namespace FastReport
{
  public class ReportScript
  {

    private void Cell6_MouseEnter(object sender, EventArgs e)
    {
      TableCell cell = sender as TableCell;
      cell.Fill = new GlassFill(Color.DarkOrange, 0.2f, false);
      cell.Page.Refresh();
    }

    private void Cell6_MouseLeave(object sender, EventArgs e)
    {
      TableCell cell = sender as TableCell;
      cell.Fill = new SolidFill(Color.PaleGreen);
      cell.Page.Refresh();
    }

    private void Cell9_MouseEnter(object sender, EventArgs e)
    {
      TableCell cell = sender as TableCell;
      cell.Fill = new GlassFill(Color.DarkOrange, 0.2f, false);
      cell.Page.Refresh();
    }

    private void Cell9_MouseLeave(object sender, EventArgs e)
    {
      TableCell cell = sender as TableCell;
      cell.Fill = new SolidFill(Color.LawnGreen);
      cell.Page.Refresh();
    }
  }
}
</ScriptText>
