  public class ReportScript
  {
    private string lasttext1=&quot;&quot;;
    private string lasttext1_2=&quot;&quot;;
    private string lastadd=&quot;&quot;;
    private string lasttext5=&quot;&quot;;
    private string lastadd2=&quot;&quot;;

    private void Text3_BeforePrint(object sender, EventArgs e)
    {
       DataSourceBase dsb= Report.GetDataSource(&quot;佳之家寿司备料间&quot;);
      if(lasttext1==&quot;&quot;||dsb[&quot;产品&quot;].ToString()!=lasttext1)
      {
        lasttext1= dsb[&quot;产品&quot;].ToString();
        lastadd=lastadd==&quot;&quot;?((char)0).ToString():&quot;&quot;;
      }
      Text3.Text=Text3.Text+lastadd;
    }

    private void Text5_BeforePrint(object sender, EventArgs e)
    {
       Text5.Text=Text5.Text+lastadd;
    }
    
    

    private void Text7_BeforePrint(object sender, EventArgs e)
    {
      DataSourceBase dsb= Report.GetDataSource(&quot;佳之家寿司备料间&quot;);
      if(lasttext5==&quot;&quot;||dsb[&quot;半成品&quot;].ToString()!=lasttext5||dsb[&quot;产品&quot;].ToString()!=lasttext1_2)
      {
        lasttext1_2= dsb[&quot;产品&quot;].ToString();
        lasttext5= dsb[&quot;半成品&quot;].ToString();
        lastadd2=lastadd2==&quot;&quot;?((char)0).ToString():&quot;&quot;;
      }
      Text7.Text=Text7.Text+lastadd2;
    }

    private void Text9_BeforePrint(object sender, EventArgs e)
    {
         Text9.Text=Text9.Text+lastadd2;
    }
    
    
    
    private void Text2_BeforePrint(object sender, EventArgs e)
    {
         Text2.Text=Text2.Text+lastadd2;
    }
  }
}
