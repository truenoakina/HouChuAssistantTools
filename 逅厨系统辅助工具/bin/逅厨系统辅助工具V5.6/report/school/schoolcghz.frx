  <Dictionary>
    <MsSqlDataConnection Name="Connection" ConnectionString="rijcmlq6CkS6l+niOCsMi13hWwqzPAyAki8nqR1PbOkcXKbVTDWKY0nuTO5vUI6iT4e4qsjm8pxzjo7m3XqidSVpynb7umXJWnMXDz4BFCb4heBbvduHRhxS2K/F6s1KyX4lVo+705zpVuruXrV7/5xIjXa5ILz5ydWcfFMTP2/seZ7tRFgpZUbS652EfWWaqES6hoEufH8pu9aN3IXneHyYZoYwA==">
      <TableDataSource Name="Table" Alias="schoolcghz" DataType="System.Int32" Enabled="true" SelectCommand="select fzl.FNAME as fz,m.FNUMBER,ml.FNAME,ml.FSPECIFICATION,ml.FDESCRIPTION as beizhu,t.qty,t.uname from &#13;&#10;(select od.FMATERIALID,sum(od.FQTY) as qty,ul.FNAME as uname from T_SAL_ORDERENTRY od inner join T_SAL_ORDER o on o.FID=od.FID&#13;&#10;inner join T_BD_MATERIALBASE mb on mb.FMATERIALID=od.FMATERIALID&#13;&#10;inner join t_BD_Unit_L ul on mb.FBASEUNITID=ul.FUNITID&#13;&#10;where o.FDATE&gt;=@begindate and o.FDATE&lt;=@enddate and o.FSALEORGID=516100 and o.FDOCUMENTSTATUS='C'&#13;&#10;group by od.FMATERIALID,ul.FNAME) t&#13;&#10;inner join t_bd_material m on t.FMATERIALID=m.FMATERIALID&#13;&#10;inner join t_bd_material_l ml on m.FMATERIALID=ml.FMATERIALID&#13;&#10;inner join T_BD_MATERIALGROUP_L fzl on m.FMATERIALGROUP=fzl.FID">
        <Column Name="fz" DataType="System.String"/>
        <Column Name="FNUMBER" DataType="System.String"/>
        <Column Name="FNAME" DataType="System.String"/>
        <Column Name="FSPECIFICATION" DataType="System.String"/>
        <Column Name="beizhu" DataType="System.String"/>
        <Column Name="qty" DataType="System.Decimal"/>
        <Column Name="uname" DataType="System.String"/>
        <CommandParameter Name="begindate" DataType="31" Expression="[begindate]" DefaultValue="2025-08-01"/>
        <CommandParameter Name="enddate" DataType="31" Expression="[enddate]" DefaultValue="2025-08-24"/>
      </TableDataSource>
    </MsSqlDataConnection>
    <Parameter Name="begindate" DataType="System.DateTime"/>
    <Parameter Name="enddate" DataType="System.DateTime"/>
  </Dictionary>
