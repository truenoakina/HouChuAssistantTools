  <Dictionary>
    <MsSqlDataConnection Name="Connection" ConnectionString="rijcmlqHwzMSgwTFaHpjtG3vsOj8fHlj9bZRmnZNrTbdTR/Bg8pGzFF45W835wXdXmW1OBlsX9V37VJuskUETvgU9Vu5dY2MEkk4581WyvFOgNHCxB5dIx1cSh0Bv4OOmdMtiTaCHD6eWWr5HA91ApAVMLY4DCiTEILxN6LS2TvdVeHhinhSOSOprjytWuU6Ye7+bcycOvhQFzkGIZuNXrqrKF+gg==">
      <TableDataSource Name="Table" Alias="Attendance" DataType="System.Int32" Enabled="true" SelectCommand="select emp.empname,ad.fdate,datename(weekday, ad.fdate) as weekdate,ad.begintime,ad.endtime,ad.fmark,&#13;&#10;case when (ad.endtime-ad.begintime)&gt;cfg.dayHours then 1 else 0 end as days,&#13;&#10;iif(ad.endtime-ad.begintime-iif(cfg.isWuCanKJ=1,cfg.dinetime,0)-iif(cfg.isWanCanKJ=1,cfg.dinetime,0)-cfg.regularHours&gt;0,&#13;&#10;ad.endtime-ad.begintime-iif(cfg.isWuCanKJ=1,cfg.dinetime,0)-iif(cfg.isWanCanKJ=1,cfg.dinetime,0)-cfg.regularHours,0) as overtimes,&#13;&#10;iif(ad.fmark='出勤',ad.endtime-ad.begintime-iif(cfg.isWuCanKJ=1,cfg.dinetime,0)-iif(cfg.isWanCanKJ=1,cfg.dinetime,0),0) as sumhours from FDD_AttendanceDetail ad &#13;&#10;inner join FDD_Employee emp on emp.id=ad.empid &#13;&#10;inner join FDD_Config cfg on cfg.fdate=ad.fdate where &#13;&#10;ad.factory=@factory and ad.depname=@depname and ad.ftype=@ftype and CONVERT(varchar(7),ad.fdate,120)=CONVERT(varchar(7),@fdate,120) order by emp.empname,ad.fdate">
        <Column Name="empname" DataType="System.String"/>
        <Column Name="fdate" DataType="System.DateTime" Format="Date"/>
        <Column Name="begintime" DataType="System.Decimal"/>
        <Column Name="endtime" DataType="System.Decimal"/>
        <Column Name="overtimes" DataType="System.Decimal"/>
        <Column Name="sumhours" DataType="System.Decimal"/>
        <Column Name="weekdate" DataType="System.String"/>
        <Column Name="fmark" DataType="System.String"/>
        <Column Name="days" DataType="System.Int16"/>
        <CommandParameter Name="fdate" DataType="4" Expression="[fdate]" DefaultValue="2026-05-13"/>
        <CommandParameter Name="factory" DataType="22" Expression="[factory]" DefaultValue="佳之家"/>
        <CommandParameter Name="depname" DataType="22" Expression="[depname]" DefaultValue="热厨"/>
        <CommandParameter Name="ftype" DataType="22" Expression="[ftype]" DefaultValue="正编"/>
      </TableDataSource>
    </MsSqlDataConnection>
    <Parameter Name="fdate" DataType="System.DateTime"/>
    <Parameter Name="factory" DataType="System.String"/>
    <Parameter Name="depname" DataType="System.String"/>
    <Parameter Name="ftype" DataType="System.String"/>
  </Dictionary>
